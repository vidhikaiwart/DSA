// Check if an array is sorted.

#include <iostream>
#include <vector>
using namespace std;

bool isSorted(vector<int> &arr){
    bool asc = true;
    bool dec = true;
    
      for (int i = 0 ; i < arr.size()-1; i++) {
            // Check ascending
        if(arr[i] > arr[i+1]){
            asc = false;
        }
               // Check descending
        if(arr[i] > arr[i+1]){
            dec  = false;
        }
        
    }
    return asc || dec;
}

int main()
{
 
 int n ;
 cin >> n;
 
vector<int> arr(n);
   
   for(int i = 0 ; i < n ; i++){
       cin >> arr[i] ;
   }
   
  
  if(isSorted(arr)) cout << "Array is sorted";
  
  else cout << "Array is not sorted";
  

   return 0;
}